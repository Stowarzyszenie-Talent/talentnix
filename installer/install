#!/usr/bin/env bash

set -euo pipefail
IFS=$'\t\n'

function err() {
	echo "[31merror[0m: $*" >/dev/stderr
}

function warn() {
	echo "[33mwarn[0m: $*" >/dev/stderr
}

function log() {
	echo "[36minfo[0m: $*" >/dev/stderr
}

function debug() {
	echo "[34mdebug[0m: $*" >/dev/stderr
}

function dbg() {
	debug "$@"
}

function abort() {
	(( $# > 0 )) &&
		err "$@"
	exit 1
}

function prompt() {
	echo -n "[1;35m==> [0m$* " >/dev/stderr
}

function read_password() {
	local password confirmation
	while true; do
		prompt "${1^} password:"
		IFS= read -rs password || abort "Unable to read $1 password."
		echo >/dev/stderr
		prompt "Confirm $1 password:"
		IFS= read -rs confirmation || abort "Unable to read $1 password confirmation."
		echo >/dev/stderr
		if [[ -n $password && $password == "$confirmation" ]]; then
			printf '%s\n' "$password"
			return
		fi
		warn "Enter a non-empty password that matches its confirmation."
	done
}

function hash_grub_password() {
	local output
	output=$(printf '%s\n' "$1" "$1" | LC_ALL=C grub-mkpasswd-pbkdf2) || return 1
	printf '%s\n' "${output##* }"
}

# Prints the hash served at URL $2 when fetching is enabled ($1 == true).
function fetch_password_hash() {
	[[ $1 == true && -n $2 ]] || return 1
	curl --fail --silent --show-error --max-time 10 --proto '=https' -- "$2"
}

pick_result=""

function pick() {
	local default

	for option in "$@"; do
		[[ ${#option} != 1 ]] && abort "pick: $option is not a single letter"
		[[ ${option,,} != "$option" ]] && default=${option,,}
	done
    pick_result="$default"

	local in
	read -rn 1 in
	in=${in,,}

	for option in "$@"; do
		[[ $in == "$option" ]] && pick_result="$option"
	done

    [ "$in" != "" ] && echo || true
}

if [[ $(id -u) -ne 0 ]]; then
	exec sudo "${BASH_SOURCE[0]}" || exit 1
fi

function print_devices() {
	found=()
	while read -rd $'\0' path; do
		found+=("$path")
	done < <(find /dev/ -regex "$2" -print0)

	if [[ ${#found[@]} -gt 0 ]]; then
		IFS=' '
		log "$1: ${found[*]}"
		IFS=$'\t\n'
	fi
}

function try_ping() {
    ping -c 1 -W 2 $1 &>/dev/null
}

configs_server="https://flash.talent.edu.pl/talentnix"

internet_tries=1
while ! try_ping 1.1.1.1 && ! try_ping 8.8.8.8; do
    log "Waiting for internet connection, ${internet_tries} attempts made..."
    # Make the next message overwrite the above one.
    tput cuu1
    ((++internet_tries))
    sleep 2
done

# The trailing spaces are to erase the remainder of the "Waiting for..." message.
log "Got internet connection after ${internet_tries} attempts!                "

mac=$(ip link show | grep -A1 "^[0-9].*state UP" | grep -v "lo\|wlan\|wlp\|ww" | grep "link/ether" | head -n1 | awk '{print $2}' || true)

get_hostname="$configs_server/hostname/$mac"
get_config="$configs_server/config/$mac"

status_config=$(curl -s -o /dev/null -w "%{http_code}" "$get_config" || echo "000")

if [ "$status_config" -eq 200 ]; then
	source <(curl -sS "$get_config")
fi

wifiLock="${WIFI_LOCK:-}"
clearHomeAlways="${CLEAR_HOME_ALWAYS:-}"
useEFI="${USE_EFI:-}"
poweroffAfterInstall="${POWEROFF_AFTER_INSTALL:-}"

# GRUB: SET_GRUB_PWD=true + GRUB_PWD_FILE (single-line grub-mkpasswd-pbkdf2 hash), otherwise prompt.
grubHashPattern='^grub\.pbkdf2\.sha512\.[1-9][0-9]*\.([[:xdigit:]]{2})+\.[[:xdigit:]]{128}$'
grubHash=$(fetch_password_hash "${SET_GRUB_PWD:-}" "${GRUB_PWD_FILE:-}") || grubHash=""
if [[ ! $grubHash =~ $grubHashPattern ]]; then
	grubPassword=$(read_password GRUB)
	grubHash=$(hash_grub_password "$grubPassword") || abort "Unable to hash the GRUB password."
	unset grubPassword
	[[ $grubHash =~ $grubHashPattern ]] || abort "Invalid GRUB password hash."
fi

# Root: SET_ROOT_PWD=true + ROOT_PWD_FILE (single-line yescrypt or SHA-512 crypt hash), otherwise prompt.
rootHashPattern='^(\$y\$[./A-Za-z0-9]+\$[./A-Za-z0-9]+\$[./A-Za-z0-9]{43}|\$6\$(rounds=[0-9]+\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86})$'
rootHash=$(fetch_password_hash "${SET_ROOT_PWD:-}" "${ROOT_PWD_FILE:-}") || rootHash=""
if [[ ! $rootHash =~ $rootHashPattern ]]; then
	rootPassword=$(read_password root)
	rootHash=$(printf '%s\n' "$rootPassword" | mkpasswd --stdin --method=yescrypt) || abort "Unable to hash the root password."
	unset rootPassword
	[[ $rootHash =~ $rootHashPattern ]] || abort "Invalid root password hash."
fi

# Smallest disk the repart.d definitions fit on.
min_size_gibibytes=32;
min_size_bytes="$((min_size_gibibytes*1024*1024*1024))"

if [ $(lsblk -d -n -o NAME | grep -E "^(nvme|sd|vd)" | wc -l) -eq 1 ] &&
   [ $(lsblk -d -n -b -o NAME,SIZE | grep -E "^(nvme|sd|vd)" | awk -v min="$min_size_bytes" '$2 >= min {count++} END {print count+0}') -eq 1 ]; then
	if [ "$status_config" != "200" ]; then
		prompt "Do you want to install talentnix? (IT WILL WIPE YOUR DRIVE!!!) [y/N]"
        pick y N
		[[ $pick_result != y ]] && exit 0
    fi
    read -r install_device <<< "/dev/$(lsblk -d -n -o NAME | grep -E "^(nvme|sd|vd)")"
else
	log "Available devices:"
	lsblk -d -o NAME,SIZE
	echo
	print_devices "sd" "/dev/sd[a-Z]+"
	print_devices "vd" "/dev/vd[a-Z]+"
	print_devices "nvme" "/dev/nvme[0-9]+n[0-9]+"

	while true; do
		prompt "Installation device path:"
		read -r install_device

		if [[ -b $install_device && $(lsblk -dno TYPE -- "$install_device") == disk ]]; then
			break
		else
			err "$install_device is not a whole disk"
		fi
	done
fi

if [[ $install_device =~ ^/dev/nvme[0-9]+n[0-9]+$ ]]; then
	install_device_part_prefix="${install_device}p"
else
	install_device_part_prefix="${install_device}"
fi

partition_bios_grub="${install_device_part_prefix}1"
partition_efi="${install_device_part_prefix}2"
partition_root="${install_device_part_prefix}3"
partition_home="${install_device_part_prefix}4"
partition_workers="${install_device_part_prefix}5"
partition_swap="${install_device_part_prefix}6"

log "Unmounting partitions"
umount -Rq /mnt || true
swapoff -a

log "Formatting $install_device with systemd-repart"

# Partitions are created and numbered in the order of the repart.d files (10-bios ... 60-swap),
# so they match the partition_* paths above.
systemd-repart --definitions="@repartDefinitions@" --empty=force --dry-run=no --discard=no --seed=random "$install_device"
udevadm settle

for partition in "$partition_bios_grub" "$partition_efi" "$partition_root" "$partition_home" "$partition_workers" "$partition_swap"; do
	[[ -b $partition ]] || abort "Partition $partition was not created."
done

log "Generating default configuration"

if [ $(curl -s -o /dev/null -w "%{http_code}" "$get_hostname" || echo "000") -eq 200 ]; then
    hostname=$(curl -s "$get_hostname")
	log "Hello!! I'm $hostname."
else
    prompt "Hostname:"
	# shellcheck disable=2034
	read -r hostname
fi

if [ "$wifiLock" == "" ]; then
	prompt "Wifi SSID to lock to (or blank for no lock):"
	read -r wifiLock
fi

if [ "$wifiLock" == "false" ]; then
	wifiLock=""
fi

rm -rf /tmp/installer
mkdir /tmp/installer
cd /tmp/installer

mount -o noatime "${partition_root}" /mnt
swapon "${partition_swap}"
mount -o noatime -m "${partition_home}" /mnt/home
mount -o noatime -m "${partition_workers}" /mnt/worker

if [ "$useEFI" == "" ]; then
	prompt "Use EFI (y) or BIOS (N)? [y/N]"
    pick y N
    [[ $pick_result == y ]] && useEFI="true"
fi
if [ "$useEFI" == "true" ]; then
    mount -o noatime -m "${partition_efi}" /mnt/boot/efi
    install_device="nodev"
fi

mkdir -p /mnt/etc

cp --no-preserve=all -r "@template@" /mnt/etc/nixos
sed -i "s,&hostname&,$hostname,g" /mnt/etc/nixos/flake.nix
sed -i "s,&wifiLock&,$wifiLock,g" /mnt/etc/nixos/flake.nix
sed -i "s,&install_device&,$install_device,g" /mnt/etc/nixos/flake.nix
sed -i "s,&_stateVersion&,@stateVersion@,g" /mnt/etc/nixos/flake.nix

# The template reads both hashes from /var/lib/talentnix (hashedPasswordFile).
install -d -m 0700 /mnt/var/lib/talentnix
(
	umask 077
	printf '%s\n' "$grubHash" > /mnt/var/lib/talentnix/grubPassword
	printf '%s\n' "$rootHash" > /mnt/var/lib/talentnix/rootPassword
)
unset grubHash rootHash

nixos-generate-config --root /mnt --show-hardware-config > /mnt/etc/nixos/hardware-configuration.nix

if [ "$clearHomeAlways" == "" ]; then
	prompt "Always clear user home? [y/N]"
    pick y N
    [[ $pick_result == y ]] && clearHomeAlways="true"
fi
if [ "$clearHomeAlways" == "true" ]; then
    touch /mnt/etc/clear_home_always
fi

if [ "$poweroffAfterInstall" == "" ]; then
	prompt "After installation, power off (y) or reboot (N)? [y/N]"
    pick y N
    [[ $pick_result == y ]] && poweroffAfterInstall="true"
fi

# Copy this repository to the target's nix store and override the talentnix input so that installation can be performed without having access to this repository.
nix copy --offline --no-require-sigs --to /mnt @this@ @nixpkgs@ @hm@ @partialSystem@
(
    cd /mnt/etc/nixos;
    nix flake lock --offline --no-use-registries \
        --override-input talentnix @this@ \
        --override-input nixpkgs @nixpkgs@ \
        --override-input home-manager @hm@
)

nixos-install --no-channel-copy --no-root-password --flake /mnt/etc/nixos#"$hostname"

if [ "$poweroffAfterInstall" == "true" ]; then
    poweroff
fi
reboot
